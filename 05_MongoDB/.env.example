# Copy to .env and adjust if you need to. Every value here is optional:
# compose.yml falls back to these same defaults when .env is absent.
#
#     cp .env.example .env
#
# Note: compose.yml deliberately does NOT pin a CPU architecture. Docker picks
# the image matching your machine. If you are on Apple Silicon / ARM and have
# DOCKER_DEFAULT_PLATFORM=linux/amd64 exported in your shell, unset it or
# configure your Docker engine -- do not add a platform: key here.

# --- Image versions ---
MONGO_VERSION=8.0
MONGO_EXPRESS_VERSION=1.0.2

# --- MongoDB ---
MONGO_USER=admin
MONGO_PASSWORD=password
MONGO_PORT=27017

# --- JupyterLab (http://localhost:8889) ---
# No token is required; the notebook server is for local use only.
# Port 8889 by default so it does not clash with the Neo4j session's 8888.
JUPYTER_PORT=8889

# --- Mongo Express web UI (http://localhost:8081) ---
# ME_USER / ME_PASSWORD are the browser login, not the database credentials.
MONGO_EXPRESS_PORT=8081
ME_USER=admin
ME_PASSWORD=pass
