# Postgres bind-mount data directories (created by docker compose)
pgdata_airflow/
pgdata_prices/

# Airflow task logs
logs/

# Order JSON files produced by the price_trend_analyzer DAG,
# and the .done files left behind once order_submitter has processed them
data/orders/*.json
data/orders/*.done

# Local docker compose overrides (machine-specific, never committed).
# The committed template is .env.example -- copy it to .env to customize.
.env
!.env.example
