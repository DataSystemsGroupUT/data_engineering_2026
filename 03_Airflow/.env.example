# Copy to .env and adjust if you need to. Every value here is optional:
# compose.yml falls back to these same defaults when .env is absent.
#
#     cp .env.example .env
#
# Note: compose.yml deliberately does NOT pin a CPU architecture. Docker picks
# the image matching your machine. If you are on Apple Silicon / ARM and have
# DOCKER_DEFAULT_PLATFORM=linux/amd64 exported in your shell, unset it or
# configure your Docker engine -- do not add a platform: key here.

# --- Image versions ---
POSTGRES_VERSION=16.4
AIRFLOW_VERSION=2.8.1
PGADMIN_VERSION=REL-8_10

# --- Airflow metadata database ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_PORT=5432

# --- Prices database (the one the DAGs write to) ---
PRICES_DB_USER=prices_user
PRICES_DB_PASSWORD=prices_pass
PRICES_DB_NAME=prices_db
PRICES_DB_PORT=5433

# --- Airflow web UI ---
AIRFLOW_WEB_PORT=8080
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- pgAdmin ---
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
