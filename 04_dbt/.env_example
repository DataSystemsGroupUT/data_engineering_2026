# Copy this file to .env and adjust values if needed.
# The defaults below work out of the box for local development.

POSTGRES_VERSION=16.4

# Retail database (dbt target)
RETAIL_DB_USER=retail_user
RETAIL_DB_PASSWORD=retail_pass
RETAIL_DB_NAME=retail_db
RETAIL_DB_PORT=5434

# Airflow metadata database
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_PORT=5435

# Airflow admin UI
AIRFLOW_VERSION=2.8.1
AIRFLOW_WEB_PORT=8080
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_EMAIL=admin@example.com

# pgAdmin
PGADMIN_PORT=5051
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
