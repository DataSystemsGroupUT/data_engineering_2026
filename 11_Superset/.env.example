# Local classroom defaults. Keep the forwarded web ports private.
# Copy this file to .env before starting Compose. That copy is ignored by git.
POSTGRES_USER=superset
POSTGRES_PASSWORD=course_metadata_2026
VIZ_READER_PASSWORD=course_reader_2026
SUPERSET_ADMIN_PASSWORD=admin

# Superset needs a stable secret to sign sessions and protect saved credentials.
# This value is only for a private, local exercise. Generate a new one for any
# shared deployment and change the passwords above before exposing a port.
SUPERSET_SECRET_KEY=3a6b287fc0931d04a2f7710ee624e89b5dce02a8cb517ab5e19f69d2005e7a31

# Change either host port here if another local application uses it.
SUPERSET_PORT=8088
STREAMLIT_PORT=8501
