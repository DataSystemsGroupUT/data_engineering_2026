# Copy to .env and adjust if you need to. Every value here is optional:
# compose.yml falls back to these same defaults when .env is absent.
#
#     cp .env.example .env
#
# Note: compose.yml deliberately does NOT pin a CPU architecture. Docker picks
# the image matching your machine. If you are on Apple Silicon / ARM and have
# DOCKER_DEFAULT_PLATFORM=linux/amd64 exported in your shell, unset it or
# configure your Docker engine -- do not add a platform: key here.

# --- Image version ---
NEO4J_VERSION=5.26

# --- Credentials ---
# NEO4J_AUTH takes the form user/password. The user is always `neo4j`.
# The password must be at least 8 characters or the server refuses to start.
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- Ports ---
# 7474 = Neo4j Browser (HTTP UI), 7687 = Bolt (drivers and cypher-shell)
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- JupyterLab (http://localhost:8888) ---
# No token is required; the notebook server is for local use only.
JUPYTER_PORT=8888

# --- Memory ---
# Comfortable for a 40-movie teaching graph. Raise only if you load your own
# larger dataset and the server complains about the page cache.
NEO4J_PAGECACHE=512M
NEO4J_HEAP_MAX=1G
